<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SeamFinder.Core\SeamFinder.Core.csproj" />
    <ProjectReference Include="..\PatchForeman\PatchForeman.csproj" />
  </ItemGroup>

  <!-- Bundled so the re-verify pass's floating-object detection (which calls
       into FloatingObjectFixer.cs's own CollisionRaycaster path) gets full
       collision-awareness out of the box, matching FloatingObjectFixer.UI's
       own bundling - without these, the re-verify pass still runs, just
       falling back to heightmap-only floating-object detection. -->
  <ItemGroup>
    <Content Include="E:\Tabula Rasa\mods\Skyrim-Claude Code Modder's Toolkit\tools\collision-raycast\extract_collision.py">
      <Link>collision-raycast\extract_collision.py</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Trimmed PyNifly (NiflyDLL.dll + its pyn/ Python wrapper only) - GPL-3.0;
       see pynifly\NOTICE.md for why this is fine alongside this tool's own
       MIT license (PyNifly runs as its own separate process, never linked
       into this binary - "mere aggregation" under GPL's own FAQ). -->
  <ItemGroup>
    <None Include="..\pynifly\**" CopyToOutputDirectory="PreserveNewest" LinkBase="pynifly" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>FICO.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- .NET 9+ marks the apphost CET shadow-stack compatible by default.
         MO2's USVFS hooks the process with inline trampolines, which the
         shadow stack rejects, so the app crashed when launched from MO2's
         executables list. Synthesis, which runs fine under MO2, ships with
         this flag off too. -->
    <CETCompat>false</CETCompat>
    <Version>0.2.4</Version>
    <AssemblyVersion>0.2.4.0</AssemblyVersion>
    <FileVersion>0.2.4.0</FileVersion>
  </PropertyGroup>

</Project>
